{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/requirements-hook-audit.sh SessionStart",
        "timeout": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "./scripts/requirements-hook-audit.sh SubagentStart",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "./scripts/requirements-hook-audit.sh SubagentStop",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/requirements-hook-audit.sh Stop",
        "timeout": 10
      }
    ]
  }
}
