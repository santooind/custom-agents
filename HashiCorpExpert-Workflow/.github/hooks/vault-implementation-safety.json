{
  "version": 1,
  "hooks": {
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./scripts/vault-implementation-safety-check.sh .",
        "powershell": "./scripts/vault-implementation-safety-check.ps1 .",
        "timeout": 30
      },
      {
        "type": "command",
        "bash": "./scripts/vault-report-lint.sh reports/vault-implementation-summary.md implementation",
        "powershell": "./scripts/vault-report-lint.ps1 reports/vault-implementation-summary.md implementation",
        "timeout": 20
      },
      {
        "type": "command",
        "bash": "./scripts/vault-json-schema-validate.sh reports/vault-implementation-summary.json implementation",
        "powershell": "./scripts/vault-json-schema-validate.ps1 reports/vault-implementation-summary.json implementation",
        "timeout": 20
      }
    ]
  }
}
