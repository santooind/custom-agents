{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashicorp-expert.local/schemas/vault-test-validation-report.schema.json",
  "title": "Vault Test Validation Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "agent",
    "inputs_reviewed",
    "git_diff_reviewed",
    "executive_summary",
    "impacted_files_reviewed",
    "affected_flows",
    "minimal_test_plan",
    "tests_executed",
    "tests_not_executed",
    "tests_blocked",
    "build_validation",
    "vault_specific_validation",
    "missing_test_coverage",
    "manual_validation_checklist",
    "merge_readiness",
    "required_manual_validation",
    "risk_based_recommendation",
    "safety"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inputs_reviewed": {
      "type": "array",
      "items": { "$ref": "#/$defs/input_reviewed" }
    },
    "git_diff_reviewed": {
      "type": "object",
      "required": ["commands", "changed_files_count"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "changed_files_count": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "executive_summary": {
      "type": "object",
      "required": ["summary", "tests_executed_count", "tests_not_executed_count", "tests_blocked_count", "merge_readiness"],
      "properties": {
        "summary": { "type": "string" },
        "tests_executed_count": { "type": "integer", "minimum": 0 },
        "tests_not_executed_count": { "type": "integer", "minimum": 0 },
        "tests_blocked_count": { "type": "integer", "minimum": 0 },
        "merge_readiness": { "$ref": "#/$defs/merge_readiness" }
      },
      "additionalProperties": false
    },
    "impacted_files_reviewed": {
      "type": "array",
      "items": { "$ref": "#/$defs/impacted_file" }
    },
    "affected_flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/affected_flow" }
    },
    "minimal_test_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_plan_item" }
    },
    "tests_executed": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_executed" }
    },
    "tests_not_executed": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_not_executed" }
    },
    "tests_blocked": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_blocked" }
    },
    "build_validation": {
      "type": "array",
      "items": { "$ref": "#/$defs/build_validation" }
    },
    "vault_specific_validation": {
      "type": "array",
      "items": { "$ref": "#/$defs/vault_validation" }
    },
    "missing_test_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_coverage" }
    },
    "manual_validation_checklist": {
      "type": "array",
      "items": { "$ref": "#/$defs/manual_checklist_group" }
    },
    "merge_readiness": {
      "type": "object",
      "required": ["classification", "rationale"],
      "properties": {
        "classification": { "$ref": "#/$defs/merge_readiness" },
        "rationale": { "type": "string" },
        "required_before_merge": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "required_manual_validation": {
      "type": "array",
      "items": { "$ref": "#/$defs/manual_validation" }
    },
    "risk_based_recommendation": {
      "type": "object",
      "required": ["recommendation", "rationale", "confidence"],
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": ["Low-risk merge", "Merge after manual smoke test", "Do not merge yet"]
        },
        "rationale": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["secrets_redacted", "secret_values_printed", "destructive_commands_run", "production_systems_called"],
      "properties": {
        "secrets_redacted": { "type": "boolean", "const": true },
        "secret_values_printed": { "type": "boolean", "const": false },
        "destructive_commands_run": { "type": "boolean", "const": false },
        "production_systems_called": { "type": "boolean", "const": false },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "complexity": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Critical"]
    },
    "merge_readiness": {
      "type": "string",
      "enum": ["Ready for PR review", "Ready with manual validation", "Not ready"]
    },
    "input_reviewed": {
      "type": "object",
      "required": ["path", "status"],
      "properties": {
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["Reviewed", "Missing", "Partial"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "impacted_file": {
      "type": "object",
      "required": ["file", "change_type", "runtime_impact", "test_need", "confidence"],
      "properties": {
        "file": { "type": "string" },
        "change_type": { "type": "string" },
        "runtime_impact": { "$ref": "#/$defs/complexity" },
        "test_need": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "affected_flow": {
      "type": "object",
      "required": ["flow", "why_affected", "required_validation", "risk"],
      "properties": {
        "flow": { "type": "string" },
        "why_affected": { "type": "string" },
        "required_validation": { "type": "string" },
        "risk": { "$ref": "#/$defs/complexity" }
      },
      "additionalProperties": false
    },
    "test_plan_item": {
      "type": "object",
      "required": ["test", "type", "command", "required", "reason"],
      "properties": {
        "test": { "type": "string" },
        "type": { "type": "string" },
        "command": { "type": "string" },
        "required": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "test_executed": {
      "type": "object",
      "required": ["command", "result", "evidence", "notes"],
      "properties": {
        "command": { "type": "string" },
        "result": { "type": "string", "enum": ["Passed", "Failed", "Skipped"] },
        "exit_code": { "type": ["integer", "null"] },
        "evidence": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "test_not_executed": {
      "type": "object",
      "required": ["test", "reason", "required_before_merge"],
      "properties": {
        "test": { "type": "string" },
        "reason": { "type": "string" },
        "required_before_merge": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "test_blocked": {
      "type": "object",
      "required": ["test", "blocker", "required_owner"],
      "properties": {
        "test": { "type": "string" },
        "blocker": { "type": "string" },
        "required_owner": { "type": "string" }
      },
      "additionalProperties": false
    },
    "build_validation": {
      "type": "object",
      "required": ["tool", "detected", "command", "status", "notes"],
      "properties": {
        "tool": { "type": "string" },
        "detected": { "type": "boolean" },
        "command": { "type": "string" },
        "status": { "type": "string", "enum": ["Run", "Skipped", "Blocked", "Not detected"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "vault_validation": {
      "type": "object",
      "required": ["check", "status", "evidence", "notes"],
      "properties": {
        "check": { "type": "string" },
        "status": { "type": "string", "enum": ["Passed", "Failed", "Not checked", "Blocked"] },
        "evidence": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "missing_coverage": {
      "type": "object",
      "required": ["area", "why_it_matters", "recommended_test"],
      "properties": {
        "area": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "recommended_test": { "type": "string" }
      },
      "additionalProperties": false
    },
    "manual_validation": {
      "type": "object",
      "required": ["validation", "environment", "owner", "success_criteria"],
      "properties": {
        "validation": { "type": "string" },
        "environment": { "type": "string" },
        "owner": { "type": "string" },
        "success_criteria": { "type": "string" }
      },
      "additionalProperties": false
    },
    "manual_checklist_group": {
      "type": "object",
      "required": ["group", "items"],
      "properties": {
        "group": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "required"],
            "properties": {
              "item": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
