{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashicorp-expert.local/schemas/vault-security-review.schema.json",
  "title": "Vault Security Review",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "agent",
    "inputs_reviewed",
    "git_diff_reviewed",
    "executive_summary",
    "diff_security_scope",
    "security_control_checklist",
    "secret_exposure_review",
    "vault_auth_review",
    "vault_policy_and_path_review",
    "runtime_safety_review",
    "cicd_and_terraform_safety_review",
    "rollback_security_review",
    "findings",
    "open_security_questions",
    "merge_security_decision",
    "human_approval_checklist",
    "final_recommendation",
    "safety"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inputs_reviewed": {
      "type": "array",
      "items": { "$ref": "#/$defs/input_reviewed" }
    },
    "git_diff_reviewed": {
      "type": "object",
      "required": ["commands", "changed_files_count"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "changed_files_count": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "executive_summary": {
      "type": "object",
      "required": ["summary", "merge_security_decision", "final_recommendation", "critical_high_findings"],
      "properties": {
        "summary": { "type": "string" },
        "merge_security_decision": { "$ref": "#/$defs/merge_security_decision" },
        "final_recommendation": { "$ref": "#/$defs/final_recommendation" },
        "critical_high_findings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diff_security_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/diff_scope_item" }
    },
    "security_control_checklist": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_check" }
    },
    "secret_exposure_review": { "$ref": "#/$defs/review_section" },
    "vault_auth_review": { "$ref": "#/$defs/review_section" },
    "vault_policy_and_path_review": { "$ref": "#/$defs/review_section" },
    "runtime_safety_review": { "$ref": "#/$defs/review_section" },
    "cicd_and_terraform_safety_review": { "$ref": "#/$defs/review_section" },
    "rollback_security_review": { "$ref": "#/$defs/review_section" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/security_finding" }
    },
    "open_security_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/security_question" }
    },
    "merge_security_decision": {
      "type": "object",
      "required": ["classification", "rationale"],
      "properties": {
        "classification": { "$ref": "#/$defs/merge_security_decision" },
        "rationale": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "human_approval_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "required"],
        "properties": {
          "item": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "final_recommendation": {
      "type": "object",
      "required": ["recommendation", "confidence", "blockers"],
      "properties": {
        "recommendation": { "$ref": "#/$defs/final_recommendation" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["secrets_redacted", "secret_values_printed", "destructive_commands_run", "production_systems_called"],
      "properties": {
        "secrets_redacted": { "type": "boolean", "const": true },
        "secret_values_printed": { "type": "boolean", "const": false },
        "destructive_commands_run": { "type": "boolean", "const": false },
        "production_systems_called": { "type": "boolean", "const": false },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Info"]
    },
    "risk": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Info"]
    },
    "control_status": {
      "type": "string",
      "enum": ["Passed", "Failed", "Needs manual confirmation", "Not applicable"]
    },
    "merge_security_decision": {
      "type": "string",
      "enum": ["Safe for human approval", "Safe with conditions", "Not safe to merge"]
    },
    "final_recommendation": {
      "type": "string",
      "enum": ["Approve after human review", "Approve after conditions are met", "Request changes"]
    },
    "input_reviewed": {
      "type": "object",
      "required": ["path", "status"],
      "properties": {
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["Reviewed", "Missing", "Partial"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "diff_scope_item": {
      "type": "object",
      "required": ["file", "change_type", "security_relevant", "reason", "confidence"],
      "properties": {
        "file": { "type": "string" },
        "change_type": { "type": "string" },
        "security_relevant": { "type": "boolean" },
        "reason": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "control_check": {
      "type": "object",
      "required": ["control", "status", "evidence", "risk"],
      "properties": {
        "control": { "type": "string" },
        "status": { "$ref": "#/$defs/control_status" },
        "evidence": { "type": "string" },
        "risk": { "$ref": "#/$defs/risk" }
      },
      "additionalProperties": false
    },
    "review_section": {
      "type": "object",
      "required": ["status", "summary", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/control_status" },
        "summary": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "security_finding": {
      "type": "object",
      "required": ["severity", "finding", "evidence", "required_action", "owner"],
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "finding": { "type": "string" },
        "evidence": { "type": "string" },
        "required_action": { "type": "string" },
        "owner": { "type": "string" }
      },
      "additionalProperties": false
    },
    "security_question": {
      "type": "object",
      "required": ["question", "why_it_matters", "suggested_owner", "required_before_merge"],
      "properties": {
        "question": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "suggested_owner": { "type": "string" },
        "required_before_merge": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

