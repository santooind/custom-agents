{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hashicorp-expert.local/schemas/vault-migration-plan.schema.json",
  "title": "Vault Migration Plan",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "agent",
    "inputs_reviewed",
    "executive_summary",
    "selected_vault_pattern",
    "migration_scope",
    "secret_mapping_plan",
    "code_change_plan",
    "infrastructure_change_plan",
    "cicd_change_plan",
    "implementation_sequence",
    "minimum_test_plan",
    "rollback_plan",
    "cutover_plan",
    "risk_register",
    "open_questions",
    "implementation_readiness",
    "assumptions",
    "safety"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inputs_reviewed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status"],
        "properties": {
          "path": { "type": "string" },
          "status": { "type": "string", "enum": ["Reviewed", "Missing", "Stale", "Partial"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "executive_summary": {
      "type": "object",
      "required": ["summary", "selected_pattern", "expected_change_size", "risk_level"],
      "properties": {
        "summary": { "type": "string" },
        "selected_pattern": { "type": "string" },
        "expected_change_size": { "$ref": "#/$defs/complexity" },
        "risk_level": { "$ref": "#/$defs/complexity" }
      },
      "additionalProperties": false
    },
    "selected_vault_pattern": {
      "type": "object",
      "required": ["composed_pattern", "delivery_pattern", "auth_method", "secret_engine", "why_selected"],
      "properties": {
        "composed_pattern": { "type": "string" },
        "delivery_pattern": { "type": "string" },
        "auth_method": { "type": "string" },
        "secret_engine": { "type": "string" },
        "why_selected": { "type": "array", "items": { "type": "string" } },
        "rejected_alternatives": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "migration_scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "assumptions", "dependencies"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "secret_mapping_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/secret_mapping" }
    },
    "code_change_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/change_item" }
    },
    "infrastructure_change_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/change_item" }
    },
    "cicd_change_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/change_item" }
    },
    "implementation_sequence": {
      "type": "array",
      "items": { "$ref": "#/$defs/sequence_step" }
    },
    "minimum_test_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_item" }
    },
    "rollback_plan": {
      "type": "object",
      "required": ["steps", "verification"],
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "cutover_plan": {
      "type": "object",
      "required": ["lower_environment_rollout", "production_rollout", "monitoring", "success_criteria", "failure_criteria"],
      "properties": {
        "lower_environment_rollout": { "type": "array", "items": { "type": "string" } },
        "production_rollout": { "type": "array", "items": { "type": "string" } },
        "monitoring": { "type": "array", "items": { "type": "string" } },
        "success_criteria": { "type": "array", "items": { "type": "string" } },
        "failure_criteria": { "type": "array", "items": { "type": "string" } },
        "abort_criteria": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "risk_register": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/open_question" }
    },
    "implementation_readiness": {
      "type": "object",
      "required": ["classification", "rationale"],
      "properties": {
        "classification": { "type": "string", "enum": ["Ready", "Ready with assumptions", "Not ready"] },
        "rationale": { "type": "string" },
        "required_to_be_ready": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "safety": {
      "type": "object",
      "required": ["secrets_redacted", "source_code_modified"],
      "properties": {
        "secrets_redacted": { "type": "boolean", "const": true },
        "source_code_modified": { "type": "boolean", "const": false },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "complexity": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Critical"]
    },
    "secret_mapping": {
      "type": "object",
      "required": ["current_secret", "current_location", "usage", "target_vault_path", "target_key", "owner", "rotation_need", "notes"],
      "properties": {
        "current_secret": { "type": "string" },
        "current_location": { "type": "string" },
        "usage": { "type": "string" },
        "target_vault_path": { "type": "string" },
        "target_key": { "type": "string" },
        "owner": { "type": "string" },
        "rotation_need": { "type": "string" },
        "notes": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "change_item": {
      "type": "object",
      "required": ["file_or_component", "current_pattern", "required_change", "complexity", "risk", "confidence"],
      "properties": {
        "file_or_component": { "type": "string" },
        "current_pattern": { "type": "string" },
        "required_change": { "type": "string" },
        "complexity": { "$ref": "#/$defs/complexity" },
        "risk": { "$ref": "#/$defs/complexity" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "owner": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sequence_step": {
      "type": "object",
      "required": ["step", "action", "owner", "dependencies", "rollback_checkpoint"],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "action": { "type": "string" },
        "owner": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "rollback_checkpoint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "test_item": {
      "type": "object",
      "required": ["test_area", "scope", "success_criteria"],
      "properties": {
        "test_area": { "type": "string" },
        "scope": { "type": "string" },
        "success_criteria": { "type": "string" },
        "owner": { "type": "string" }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["risk", "impact", "likelihood", "mitigation", "owner"],
      "properties": {
        "risk": { "type": "string" },
        "impact": { "$ref": "#/$defs/complexity" },
        "likelihood": { "$ref": "#/$defs/complexity" },
        "mitigation": { "type": "string" },
        "owner": { "type": "string" }
      },
      "additionalProperties": false
    },
    "open_question": {
      "type": "object",
      "required": ["question", "why_it_matters", "suggested_owner"],
      "properties": {
        "question": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "suggested_owner": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

